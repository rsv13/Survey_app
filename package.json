{
  "name": "survey-app",
  "version": "0.1.0",
  "private": true,
  "description": "South Wales Social Well-Being Scale Survey — GraphQL research platform",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server"
  },
  "license": "MIT",
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "fsevents@2.3.3": true,
    "@apollo/protobufjs@1.2.8": true
  }
}
