# Environment mode: development | production
NODE_ENV=development

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# These MUST match the credentials in docker-compose.yaml.
DATABASE_URL="postgresql://swswbs:swswbs_dev_password@localhost:5432/swswbs"

# Signs JWT session tokens. Use any long, random string — e.g. generate one with:
#   openssl rand -base64 32
JWT_SECRET="generate-a-long-random-string"

# Seed script: the first Admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@swswbs.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Email (verification + password reset) ---
# Where the frontend runs — used to build the code/verify links in emails.
WEB_URL="http://localhost:5173"
#
# Email is sent via the Resend HTTPS API (https://resend.com — free tier). The
# HTTPS API is used instead of SMTP so it works on hosts (e.g. Render's free
# tier) that block outbound SMTP ports.
#
# Leave RESEND_API_KEY unset in dev to fall back to an Ethereal test inbox — a
# preview URL, the 6-digit code, and the verify link are printed to the server
# console, so you can verify accounts without sending real mail.
#
# RESEND_API_KEY="re_your_api_key"
# EMAIL_FROM="SWSWBS <onboarding@resend.dev>"   # the shared test sender only
#   reaches your own Resend-account email; verify a domain at resend.com/domains
#   and use an address on it to email anyone.
