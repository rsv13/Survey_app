# Environment mode: development | production
NODE_ENV=development

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# These MUST match the credentials in docker-compose.yaml.
DATABASE_URL="postgresql://swswbs:swswbs_dev_password@localhost:5432/swswbs"

# Seed script: the first Admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@swswbs.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Reserved for later phases (Phase 2 auth); not needed yet ---
# JWT_SECRET="generate-a-long-random-string"
# REFRESH_SECRET="generate-a-different-long-random-string"
# GOOGLE_CLIENT_ID=""
# CORS_ORIGIN="http://localhost:5173"

# --- Email (verification links) ---
# Where the frontend runs — used to build the verify link in emails.
WEB_URL="http://localhost:5173"
# Leave SMTP_HOST blank in dev to use an Ethereal test inbox (a preview URL is
# printed in the server console). Set these to send real email in production.
# Example below uses Brevo's free plan (300 emails/day, verify a single sender):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"           # STARTTLS on 587 (use true only for port 465)
# SMTP_USER="your-brevo-smtp-login"
# SMTP_PASS="your-brevo-smtp-key"   # the generated SMTP key, not your account password
# EMAIL_FROM="SWSWBS <your-verified-sender@example.com>"
