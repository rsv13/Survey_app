# Dependencies — recreated by `npm install`, never committed
node_modules/

# Environment secrets — NEVER commit real secrets.
# Ignore all .env files, but keep the safe template .env.example.
.env
.env.*
!.env.example

# Build output
dist/
build/

# Prisma's generated client (regenerated by `prisma generate`)
server/node_modules/.prisma/

# Logs
*.log

# macOS / editor noise
.DS_Store
.vscode/
.idea/

# Test coverage
coverage/

# Prisma generated client (regenerated by `prisma generate`)
server/src/generated/